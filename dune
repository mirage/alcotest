(env
 (_
  (wasm_of_ocaml
   (enabled_if %{env:WASM_OF_OCAML=false})
   (runtest_alias runtest-wasm))))

(rule
 (progn
  (copy examples/simple.exe test.exe)
  (with-stdout-to
   alcotest-help.txt.actual
   (run ./test.exe --help=plain))))

(rule
 (alias runtest)
 (action
  (diff alcotest-help.txt alcotest-help.txt.actual)))
