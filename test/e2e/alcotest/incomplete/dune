(env
 (_
  (env-vars
   (ALCOTEST_COLOR auto))))

(executables
 (names test_incomplete test_mixed)
 (modules test_incomplete test_mixed)
 (libraries alcotest))

(rule
 (target incomplete.actual)
 (action
  (with-outputs-to
   %{target}
   (progn
    (run %{dep:test_incomplete.exe})
    (run %{dep:test_incomplete.exe} -c)
    (run %{dep:test_incomplete.exe} --json)
    (with-accepted-exit-codes
     1
     (run %{dep:test_mixed.exe}))
    (with-accepted-exit-codes
     1
     (run %{dep:test_incomplete.exe} -c --fail-incomplete))
    (setenv
     ALCOTEST_FAIL_INCOMPLETE
     true
     (with-accepted-exit-codes
      1
      (run %{dep:test_incomplete.exe} -c)))))))

(rule
 (target incomplete.processed)
 (action
  (with-outputs-to
   %{target}
   (run ../../strip_randomness.exe %{dep:incomplete.actual}))))

(rule
 (alias runtest)
 (package alcotest)
 (action
  (diff incomplete.expected incomplete.processed)))

(test
 (name test_log)
 (modules test_log)
 (package alcotest)
 (libraries alcotest))
